# ==============================================================================
# Prep2Place Full-Stack Platform — Production Environment Template (.env.example)
# NEVER commit real secrets to Git. Copy to .env for local use or configure in
# Render / Vercel / GitHub Actions Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application URLs
# ------------------------------------------------------------------------------
PORT=8080
APP_URL=https://app.yourdomain.me
APP_CORS_ALLOWED_ORIGINS=https://app.yourdomain.me,https://yourdomain.me

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database (Neon Serverless Postgres or Render Managed Postgres)
# ------------------------------------------------------------------------------
# Format: jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech:5432/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace_with_secure_database_password
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
FLYWAY_ENABLED=true
JPA_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 3. Authentication & OAuth2 (Generate a 64-byte random string for JWT_SECRET)
# ------------------------------------------------------------------------------
# Generate via: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=replace_with_at_least_64_byte_cryptographically_random_secret

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 4. Email Service (Resend API)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_VERIFICATION_EXPIRY_MINUTES=30

# ------------------------------------------------------------------------------
# 5. Python ML Proctoring & Analysis Service
# ------------------------------------------------------------------------------
# Set ML_SERVICE_ENABLED=false on single-service free tier to use the built-in
# MockVideoAnalysisService fallback and preserve Render's 750 free hours/month.
ML_SERVICE_ENABLED=false
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. Code Execution Runner (DSA / Coding Lab)
# ------------------------------------------------------------------------------
# Options: local | docker
# Note: Render containers do not provide a Docker daemon (/var/run/docker.sock).
# Use 'local' on Render (child processes have all secret env vars scrubbed).
CODING_RUNNER_PROVIDER=local
CODING_RUNNER_LOCAL_ENABLED=true
CODING_RUNNER_LOCAL_JAVA_HEAP_MB=128
CODING_RUNNER_LOCAL_GRACE_MS=10000

# ------------------------------------------------------------------------------
# 7. Optional Redis & Kafka (Disabled by default; in-memory fallback active)
# ------------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_HEALTH_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=placement-auth-group

# ------------------------------------------------------------------------------
# 8. Optional LLM Question Generation (Admin -> Generate with AI)
# ------------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ------------------------------------------------------------------------------
# 9. Frontend (Vercel — configure in Vercel Project Settings)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.me
NEXT_PUBLIC_API_URL=https://api.yourdomain.me
